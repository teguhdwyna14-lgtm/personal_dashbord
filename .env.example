# Supabase PostgreSQL connection string (Project Settings > Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_jangan_dibagikan
SUPABASE_STORAGE_BUCKET=academic-files

# Password untuk satu-satunya pemilik dashboard
ADMIN_PASSWORD=ganti_dengan_password_yang_kuat
SESSION_SECRET=ganti_dengan_random_secret_minimal_32_karakter
PORT=3000
